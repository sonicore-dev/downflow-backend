# Copy to .env (or export in your service manager). All optional.

# ---- Cookies ---------------------------------------------------------------
# Default file: cookies/youtube.txt (Netscape format). Replace it any time, no restart needed.
# DOWNFLOW_COOKIES_DIR=/app/cookies
# DOWNFLOW_COOKIE_FILE=/app/cookies/youtube.txt
DOWNFLOW_COOKIE_SOURCE=auto            # auto | file | browser | none
DOWNFLOW_COOKIE_WRITEBACK=1            # keep cookies that YouTube rotates during use
DOWNFLOW_COOKIE_CHECK_INTERVAL=3600    # seconds between live validity checks (0 = off)

# ---- Persistent browser profile (alternative to the file) -------------------
# DOWNFLOW_BROWSER_PROFILE_DIR=/app/browser-profile
# DOWNFLOW_BROWSER_NAME=chromium
# DOWNFLOW_BROWSER_KEYRING=basictext
# or a full yt-dlp spec:
# DOWNFLOW_COOKIES_FROM_BROWSER=chromium+basictext:/app/browser-profile

# ---- Proxy (residential / rotating) -----------------------------------------
# DOWNFLOW_PROXY=http://user:pass@host:port
# DOWNFLOW_PROXY_LIST=http://u:p@h1:8000,http://u:p@h2:8000
# DOWNFLOW_PROXY_FILE=/app/proxies.txt
# DOWNFLOW_PROXY_MODE=sticky           # sticky | round_robin | random

# ---- Anti-bot behaviour -----------------------------------------------------
DOWNFLOW_FORCE_IPV4=1
DOWNFLOW_SLEEP_REQUESTS=0.5
# DOWNFLOW_SLEEP_INTERVAL=0
# DOWNFLOW_YT_PLAYER_CLIENTS=web_safari,web,mweb,tv
# DOWNFLOW_YT_PO_TOKEN=web.gvs+XXXX
# DOWNFLOW_YT_VISITOR_DATA=XXXX

# ---- Anti-blocking layer (see README "Anti-blocking layer") -----------------
# Sticky residential session: {sid} is filled with a per-video id (same IP for extract + download).
# DOWNFLOW_PROXY=http://user-session-{sid}:pass@gate.example.com:7000
# DOWNFLOW_PROXY_COOLDOWN=90            # base seconds a blocked/dead proxy is parked (doubles per failure, max 30 min)
# DOWNFLOW_PROXY_AFFINITY_TTL=7200      # remember which proxy served a URL (media links are IP-bound)
# DOWNFLOW_PROXY_DIRECT_FALLBACK=1      # connect directly if every proxy is unusable
# DOWNFLOW_PROXY_MODE=sticky            # sticky | round_robin | random | weighted
DOWNFLOW_COOKIE_POLICY=last             # last = cookie-less routes first (safer for the account) | first | never
DOWNFLOW_RACE_WIDTH=2                   # strategies allowed to run in parallel (1 = sequential)
DOWNFLOW_HEDGE_DELAY=5                  # start the next strategy in parallel after N seconds (0 = off)
DOWNFLOW_CACHE_TTL=900                  # seconds identical extractions are served from memory
# DOWNFLOW_POT_URL=http://127.0.0.1:4416  # PO-token provider (the Docker image starts it for you)
# DOWNFLOW_POT_SERVER=1                 # start.sh: run the bundled provider (set in the Dockerfile)
DOWNFLOW_AUTO_UPDATE=off                # off | stable | nightly  (Dockerfile sets stable)
# DOWNFLOW_UPDATE_INTERVAL=21600

# ---- Instant Save ----------------------------------------------------------
# DOWNFLOW_INSTANT_VIDEO_FORMAT=b/bv*+ba/b   # best single file first (fast), merge only if needed
# DOWNFLOW_INSTANT_AUDIO_FORMAT=ba/b
# DOWNFLOW_INSTANT_ATTEMPTS=3
# DOWNFLOW_INSTANT_BUDGET=45

# ---- Scale & protection (see README "Scaling") -----------------------------
# DOWNFLOW_WORKERS=1                    # uvicorn processes; "auto" = CPU count. More than 1 REQUIRES DOWNFLOW_REDIS_URL
# DOWNFLOW_REDIS_URL=redis://localhost:6379/0   # shared task store + rate limits (needed for workers>1 or several instances)
# DOWNFLOW_MAX_INFLIGHT=2000            # requests handled at once per worker; beyond this: instant 503 + Retry-After
# DOWNFLOW_MAX_CONNECTIONS=10000        # open sockets per worker (0 = unlimited)
# DOWNFLOW_BACKLOG=4096                 # OS accept queue
# DOWNFLOW_KEEPALIVE=5                  # idle keep-alive seconds
# DOWNFLOW_RECYCLE_AFTER=0              # restart a worker after N requests (0 = never)
# DOWNFLOW_API_RATE=300/60              # per-IP flood guard for /api/ (requests/seconds)
# DOWNFLOW_RL_EXTRACT=20/60             # per-IP limit for extraction; DOWNFLOW_RL_DOWNLOAD likewise
# DOWNFLOW_MAX_BODY=65536               # max request body bytes
# DOWNFLOW_MAX_IP_STREAMS=4             # simultaneous downloads per IP
# DOWNFLOW_PROXY_HOPS=1                 # trusted reverse proxies in front (Render/Cloudflare = 1). 0 = use the TCP peer
# DOWNFLOW_CLIENT_IP_HEADER=CF-Connecting-IP
# DOWNFLOW_ACCESS_LOG_RPS=50            # above this rate only failed/slow requests are logged individually
# DOWNFLOW_SLOW_REQUEST=3               # seconds before a request is flagged "slow"

# ---- Logging ---------------------------------------------------------------
# DOWNFLOW_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# DOWNFLOW_LOG_FORMAT=pretty            # pretty (coloured) | plain | json (log shippers)
# DOWNFLOW_COLOR=1                      # force colour on (Docker/Render logs) ; 0 = off ; NO_COLOR is honoured
# DOWNFLOW_LOG_BUFFER=3000              # lines kept for the admin terminal

# ---- Admin (CHANGE THESE in production) ------------------------------------
# DOWNFLOW_ADMIN_USER=admin
# DOWNFLOW_ADMIN_PASS=change-me
# DOWNFLOW_SECRET=long-random-string    # signs admin sessions; set it so logins survive restarts / workers
